<UserControl
    x:Class="CSharpDemo.Views.SerialPortView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:CSharpDemo.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:SerialPortViewModel}"
    d:DesignHeight="720"
    d:DesignWidth="1080"
    Background="{DynamicResource FirstBgBrush}"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="0,10"
                FontSize="18"
                Foreground="{DynamicResource ForegroundBrush}"
                Text="数据收发区" />

            <ListBox
                Grid.Row="1"
                Background="{DynamicResource ThirdBgBrush}"
                BorderBrush="{DynamicResource BackgroundBrush}"
                ItemsSource="{Binding ResponseCollection}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Padding="5,8"
                            FontSize="14"
                            Foreground="{DynamicResource ForegroundBrush}"
                            Text="{Binding}"
                            TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,0,1" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <Grid
                Grid.Row="2"
                Height="35"
                Margin="0,15">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>

                <hc:TextBox
                    Grid.Column="0"
                    VerticalContentAlignment="Center"
                    hc:InfoElement.Placeholder="请输入或者选择要发送的数据"
                    hc:InfoElement.ShowClearButton="True"
                    Background="{DynamicResource ThirdBgBrush}"
                    FontSize="16"
                    Foreground="{DynamicResource ForegroundBrush}"
                    Text="{Binding UserInputHex}" />

                <hc:ComboBox
                    x:Name="CommandComboBox"
                    Grid.Column="1"
                    Margin="15,0,0,0"
                    SelectedIndex="0">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="SelectionChanged">
                            <b:InvokeCommandAction Command="{Binding ItemSelectedCommand}" CommandParameter="{Binding ElementName=CommandComboBox, Path=SelectedIndex}" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                    <ComboBoxItem Content="请选择" />
                    <ComboBoxItem Content="唤醒红色传感器" />
                    <ComboBoxItem Content="唤醒蓝色传感器" />
                    <ComboBoxItem Content="采集数据" />
                </hc:ComboBox>
            </Grid>
        </Grid>

        <Grid Grid.Column="1" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Vertical">
                <TextBlock
                    Margin="0,10"
                    FontSize="18"
                    Foreground="{DynamicResource ForegroundBrush}"
                    Text="参数设置" />

                <DockPanel LastChildFill="True">
                    <TextBlock
                        Width="80"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{DynamicResource ForegroundBrush}"
                        Text="端口：" />

                    <hc:ComboBox
                        x:Name="PortNameComboBox"
                        Height="30"
                        Background="{DynamicResource ThirdBgBrush}"
                        Foreground="{DynamicResource ForegroundBrush}"
                        IsEnabled="{Binding ComboBoxEnabled}"
                        ItemsSource="{Binding PortArray}">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="SelectionChanged">
                                <b:InvokeCommandAction Command="{Binding PortNameItemSelectedCommand}" CommandParameter="{Binding ElementName=PortNameComboBox, Path=SelectedItem}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </hc:ComboBox>
                </DockPanel>

                <DockPanel LastChildFill="True">
                    <TextBlock
                        Width="80"
                        Margin="0,15"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{DynamicResource ForegroundBrush}"
                        Text="波特率：" />

                    <hc:ComboBox
                        x:Name="BaudRateComboBox"
                        Height="30"
                        Background="{DynamicResource ThirdBgBrush}"
                        Foreground="{DynamicResource ForegroundBrush}"
                        IsEnabled="{Binding ComboBoxEnabled}"
                        ItemsSource="{Binding BaudRateList}"
                        SelectedIndex="8">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="SelectionChanged">
                                <b:InvokeCommandAction Command="{Binding BaudRateItemSelectedCommand}" CommandParameter="{Binding ElementName=BaudRateComboBox, Path=SelectedItem}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </hc:ComboBox>
                </DockPanel>

                <DockPanel LastChildFill="True">
                    <TextBlock
                        Width="80"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{DynamicResource ForegroundBrush}"
                        Text="数据位：" />

                    <hc:ComboBox
                        x:Name="DataBitComboBox"
                        Height="30"
                        Background="{DynamicResource ThirdBgBrush}"
                        Foreground="{DynamicResource ForegroundBrush}"
                        IsEnabled="{Binding ComboBoxEnabled}"
                        ItemsSource="{Binding DataBitList}"
                        SelectedIndex="3">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="SelectionChanged">
                                <b:InvokeCommandAction Command="{Binding DataBitItemSelectedCommand}" CommandParameter="{Binding ElementName=DataBitComboBox, Path=SelectedItem}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </hc:ComboBox>
                </DockPanel>

                <DockPanel LastChildFill="True">
                    <TextBlock
                        Width="80"
                        Margin="0,15"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{DynamicResource ForegroundBrush}"
                        Text="校验位：" />

                    <hc:ComboBox
                        x:Name="ParityComboBox"
                        Height="30"
                        Background="{DynamicResource ThirdBgBrush}"
                        Foreground="{DynamicResource ForegroundBrush}"
                        IsEnabled="{Binding ComboBoxEnabled}"
                        ItemsSource="{Binding ParityList}"
                        SelectedIndex="0">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="SelectionChanged">
                                <b:InvokeCommandAction Command="{Binding CheckModeItemSelectedCommand}" CommandParameter="{Binding ElementName=ParityComboBox, Path=SelectedItem}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </hc:ComboBox>
                </DockPanel>

                <DockPanel LastChildFill="True">
                    <TextBlock
                        Width="80"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{DynamicResource ForegroundBrush}"
                        Text="停止位：" />

                    <hc:ComboBox
                        x:Name="StopBitComboBox"
                        Height="30"
                        Background="{DynamicResource ThirdBgBrush}"
                        Foreground="{DynamicResource ForegroundBrush}"
                        IsEnabled="{Binding ComboBoxEnabled}"
                        ItemsSource="{Binding StopBitList}"
                        SelectedIndex="0">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="SelectionChanged">
                                <b:InvokeCommandAction Command="{Binding StopBitItemSelectedCommand}" CommandParameter="{Binding ElementName=StopBitComboBox, Path=SelectedItem}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                    </hc:ComboBox>
                </DockPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Width="80"
                        Margin="0,15"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{DynamicResource ForegroundBrush}"
                        Text="串口状态：" />

                    <Ellipse
                        Width="20"
                        Height="20"
                        Fill="{Binding StateColorBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel
                Grid.Row="2"
                Margin="0,0,0,15"
                Orientation="Vertical">
                <Button
                    Width="185"
                    Height="35"
                    Command="{Binding OpenSerialPortCommand}"
                    Content="{Binding ButtonContent}"
                    FontSize="16"
                    Style="{StaticResource ButtonPrimary}" />

                <Button
                    Width="185"
                    Height="35"
                    Margin="0,15"
                    HorizontalAlignment="Center"
                    Command="{Binding ClearMessageCommand}"
                    Content="清空记录"
                    FontSize="16"
                    Style="{StaticResource ButtonWarning}" />

                <Button
                    Width="185"
                    Height="35"
                    Command="{Binding SendMessageCommand}"
                    Content="发送数据"
                    FontSize="16"
                    Style="{StaticResource ButtonSuccess}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>